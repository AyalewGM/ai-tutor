      "id": "W2-G1-ADDITION-UNKNOWN",
      "grades": "Grades 1–2",
      "concept": "Addition/subtraction unknown-position structures",
      "existing_reuse": "Existing elementary addition and subtraction word-problem families; deepen representations",
      "status": "DRAFT_UNVERIFIED",
      "runtime_activation": false,
      "mastery_writes": false,
      "standards_mapping": "PROVISIONAL_NOT_ACCEPTED",
      "mathematical_review": "PENDING",
      "qa": "PENDING",
      "diagnostic": [
        "A child has 8 counters, receives some, and now has 13. Ask how many arrived.",
        "Show 5 red and 4 blue counters; ask what total means."
      ],
      "lesson_sequence": [
        "Elicit a prediction from a contextual concrete model.",
        "Manipulate a visual representation and describe what stays invariant.",
        "Translate visual steps into exact mathematical statements.",
        "Contrast correct and incorrect reasoning through a counterexample.",
        "Fade scaffolds and require independent explanation and transfer."
      ],
      "worked_examples": [
        {
          "prompt": "8 + □ = 13",
          "steps": [
            "Start with eight counters.",
            "Add counters until thirteen are visible.",
            "Count added counters."
          ],
          "answer": "5"
        },
        {
          "prompt": "□ + 7 = 12",
          "steps": [
            "Place seven known counters in a ten-frame.",
            "Fill remaining places to reach twelve."
          ],
          "answer": "5"
        },
        {
          "prompt": "14 − □ = 9",
          "steps": [
            "Start with fourteen counters.",
            "Remove until nine remain.",
            "Count removed."
          ],
          "answer": "5"
        },
        {
          "prompt": "□ − 6 = 8",
          "steps": [
            "Show eight counters remaining.",
            "Put six removed counters back to reconstruct the start."
          ],
          "answer": "14"
        },
        {
          "prompt": "9 + 6 = □",
          "steps": [
            "Make ten using one from six.",
            "Ten plus five gives fifteen."
          ],
          "answer": "15"
        }
      ],
      "misconception_pathways": [
        {
          "wrong_idea": "Answer uses total rather than unknown",
          "probe": "For 8+□=13, is 13 the missing part?",
          "hints": [
            "What does the box represent?",
            "Which counters were added?"
          ],
          "repair": "Color the starting and arriving counters differently."
        },
        {
          "wrong_idea": "Subtraction always means smaller number first",
          "probe": "For □−6=8, is the start 2?",
          "hints": [
            "Could two counters lose six?",
            "Reverse the removal with an addition."
          ],
          "repair": "Act out take-away and restore six."
        },
        {
          "wrong_idea": "Equal sign means 'write answer next'",
          "probe": "Is 8+5=7+6 true?",
          "hints": [
            "Count each side.",
            "Does the equal sign mean both sides have same value?"
          ],
          "repair": "Balance a virtual scale with two expressions."
        }
      ],
      "guided_practice": [
        {
          "prompt": "□+4=11",
          "answer": "7",
          "reason": "11−4",
          "scaffold_allowed": true
        },
        {
          "prompt": "17−□=8",
          "answer": "9",
          "reason": "17−8",
          "scaffold_allowed": true
        },
        {
          "prompt": "□−5=9",
          "answer": "14",
          "reason": "9+5",
          "scaffold_allowed": true
        },
        {
          "prompt": "6+8=□",
          "answer": "14",
          "reason": "6+8",
          "scaffold_allowed": true
        }
      ],
      "independent_assessment": [
        {
          "prompt": "□+9=16",
          "answer": "7",
          "oracle_reason": "16−9",
          "hints_allowed": false,
          "feedback_after_submission": true
        },
        {
          "prompt": "18−□=11",
          "answer": "7",
          "oracle_reason": "18−11",
          "hints_allowed": false,
          "feedback_after_submission": true
        },
        {
          "prompt": "Transfer: 6 apples are in a basket; after adding some, there are 15. How many were added?",
          "answer": "9",
          "oracle_reason": "15−6",
          "hints_allowed": false,
          "feedback_after_submission": true
        }
      ],
      "interactive_spec": {
        "scene": "ten-frames, counters, balance scale",
        "controls": [
          "drag counters",
          "toggle hidden start/change/result",
          "show number bond",
          "balance expressions"
        ],
        "events": [
          "UNKNOWN_POSITION_IDENTIFIED",
          "COUNTER_EXCHANGE",
          "EQUALITY_EXPLAIN"
        ],
        "accessibility": "keyboard add/remove, spoken count and equation, no reliance on color",
        "assessment": "disable manipulatives and hints"
      },
      "mastery_gate": "NOT_CONFIGURED_PENDING_REVIEW"
    },
