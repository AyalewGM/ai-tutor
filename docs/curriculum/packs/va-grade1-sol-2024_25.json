      "problems": [
        {
          "key": "va1-add_sub_20-addition_within_20-01",
          "family": "ADDITION_WITHIN_20",
          "prompt": "5 apples and 4 apples are on the table. How many apples are there?",
          "canonical_answer": "9",
          "difficulty": 1,
          "objective": "Add within 20 using a ten-frame model.",
