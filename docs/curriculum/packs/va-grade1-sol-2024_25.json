          "family": "SUBTRACTION_WITHIN_20",
          "prompt": "There are 15 birds on a branch. 7 fly away. How many birds are left?",
          "canonical_answer": "8",
          "difficulty": 1,
          "objective": "Subtract within 20 using a ten-frame model.",
