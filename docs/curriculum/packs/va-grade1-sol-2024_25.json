          "difficulty": 2,
          "objective": "Add within 20 using a ten-frame model.",
          "modes": [
            "independent"
          ],
          "parameters": {
            "a": 8,
            "b": 9,
            "operation": "+"
          }
        },
        {
          "key": "va1-add_sub_20-subtraction_within_20-04",
          "family": "SUBTRACTION_WITHIN_20",
          "prompt": "There are 14 birds on a branch. 6 fly away. How many birds are left?",
