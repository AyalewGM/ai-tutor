            "guided"
          ],
          "parameters": {
            "a": 15,
            "b": 7,
            "operation": "-"
          }
        },
        {
          "key": "va1-add_sub_20-addition_within_20-03",
          "family": "ADDITION_WITHIN_20",
          "prompt": "8 apples and 9 apples are on the table. How many apples are there?",
