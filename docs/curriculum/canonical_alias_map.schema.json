{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mihur canonical alias mapping contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_version",
    "authority",
    "release_status",
    "aliases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "release_status": {
      "enum": [
        "DRAFT_NOT_FOR_RUNTIME",
        "REVIEWED_FOR_PUBLICATION"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "status",
          "relation",
          "target_skill_codes",
          "evidence",
          "reviewed_by"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^MATH\\.ELEMENTARY\\."
          },
          "status": {
            "enum": [
              "UNMAPPED",
              "PROPOSED",
              "REVIEWED"
            ]
          },
          "relation": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ALL_OF",
              null
            ]
          },
          "target_skill_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
