# Copy OUTSIDE the checkout to /etc/mihur-staging/release.env, mode 0600.
# Generate a staging-only 64-character hex password; never reuse credentials.
STAGING_DB_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# All six images must use immutable registry digest references, never tags.
# Build application images off-host from the same reviewed SHA.
STAGING_RELEASE_SHA=REPLACE_WITH_40_CHARACTER_GIT_SHA
STAGING_API_IMAGE=registry.example/mihur-api@sha256:REPLACE
STAGING_GATEWAY_IMAGE=registry.example/mihur-gateway@sha256:REPLACE
STAGING_FRONTEND_IMAGE=registry.example/mihur-frontend@sha256:REPLACE
STAGING_DB_IMAGE=postgres@sha256:REPLACE
STAGING_REDIS_IMAGE=redis@sha256:REPLACE
STAGING_PROXY_IMAGE=caddy@sha256:REPLACE
