AI_PROVIDER=fallback
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
GEMINI_API_KEY=

# Parent PIN rate limiting and short-lived adult unlocks
REDIS_URL=redis://redis:6379/0

# Staff (admin) two-factor: Fernet key that encrypts TOTP secrets at rest.
# Generate once per environment and keep it secret; losing it means admins re-enroll.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- Pilot family approval -------------------------------------------------
# New self-registered families wait for admin approval while this is true.
REQUIRE_FAMILY_APPROVAL=true
# Base URL used in email links (no trailing slash).
PUBLIC_BASE_URL=https://mihur.example.com

# --- Outbound email (Gmail for the pilot) ----------------------------------
# console = log a redacted summary and send nothing (safe default).
# smtp    = deliver. For Gmail: turn on 2-Step Verification, create an
#           App Password (Google Account > Security > App passwords), and
#           paste the 16-character code below. Never use your real password.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=your.address@gmail.com
# Where "new family awaiting approval" notifications are sent.
ADMIN_NOTIFICATION_EMAIL=your.address@gmail.com
