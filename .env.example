AI_PROVIDER=fallback
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
GEMINI_API_KEY=

# AI budgets: per-family daily AI-generation cap (per-family override lives on
# the profile; otherwise the family's plan default applies), a global monthly
# USD cap, and the spend alert threshold that emails the admin.
AI_BUDGETS_ENABLED=true
FAMILY_AI_DAILY_GENERATIONS=50
AI_MONTHLY_COST_CAP_USD=200.00
AI_BUDGET_ALERT_PCT=0.8

# CAD pricing: fallback USD→CAD rate used until an admin recalculates the
# Bank of Canada 3-year average (stored in platform_settings). CAD plan
# prices are fixed whole-dollar amounts, never live conversions.
USD_TO_CAD_FALLBACK=1.36
FX_FETCH_TIMEOUT_SECONDS=10.0

# Parent PIN rate limiting and short-lived adult unlocks
REDIS_URL=redis://redis:6379/0

# Staff (admin) two-factor: Fernet key that encrypts TOTP secrets at rest.
# Generate once per environment and keep it secret; losing it means admins re-enroll.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- Pilot family approval -------------------------------------------------
# New self-registered families wait for admin approval while this is true.
REQUIRE_FAMILY_APPROVAL=true
# Base URL used in email links (no trailing slash).
PUBLIC_BASE_URL=https://mihur.example.com

# --- Outbound email (Gmail for the pilot) ----------------------------------
# console = log a redacted summary and send nothing (safe default).
# smtp    = deliver. For Gmail: turn on 2-Step Verification, create an
#           App Password (Google Account > Security > App passwords), and
#           paste the 16-character code below. Never use your real password.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=your.address@gmail.com
# Where "new family awaiting approval" notifications are sent.
ADMIN_NOTIFICATION_EMAIL=your.address@gmail.com

# --- Stripe billing ---------------------------------------------------------
# Empty keys = billing disabled (checkout endpoints return 503).
# Create Prices in Stripe for each paid plan, then set the ids via
# PATCH /api/v1/admin/plans (stripe_price_id_usd / stripe_price_id_cad).
STRIPE_SECRET_KEY=
# From `stripe listen` (dev) or the webhook endpoint's signing secret (prod).
STRIPE_WEBHOOK_SECRET=
# Card-required trial length (Stripe collects the payment method up front).
STRIPE_TRIAL_DAYS=14

# --- Cloudflare edge security (see docs/operations/CLOUDFLARE_SETUP.md) -----
# Only set CLOUDFLARE_TRUSTED=true once the origin is locked down so ONLY
# Cloudflare can reach it — otherwise the CF-* headers are spoofable.
CLOUDFLARE_TRUSTED=false
# Block requests whose country is missing, unknown ("XX"/"T1"), or outside
# ALLOWED_COUNTRIES. Fails closed. Leave false until Cloudflare fronts the app.
GEO_ENFORCEMENT_ENABLED=false
ALLOWED_COUNTRIES=US,CA

# Sign-in / registration throttles (Redis). Keep enabled in production.
AUTH_THROTTLES_ENABLED=true
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_PER_IP=5
REGISTER_RATE_WINDOW_SECONDS=3600
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Cloudflare Turnstile bot check on sign-in/registration. Enabled when the
# secret key is set. Site key goes to the browser; secret stays server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
