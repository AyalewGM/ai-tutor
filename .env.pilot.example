# Private-family pilot environment template.
# Copy to .env.pilot on the VPS and replace every CHANGE_ME value.
# Never commit .env.pilot or real family credentials.

POSTGRES_USER=ai_tutor
POSTGRES_DB=ai_tutor
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# Browser sessions must be secure in the HTTPS pilot environment.
SESSION_COOKIE_SECURE=true

# Existing application provider routing.
AI_PROVIDER=gateway
LLM_GATEWAY_PROVIDER=CHANGE_ME_PROVIDER

# AI budgets: placeholder limits until real usage is known — edit per family
# in the admin dashboard or globally here. Denied calls fall back to built-in
# tutor messages, so learners keep working.
AI_BUDGETS_ENABLED=true
FAMILY_AI_DAILY_GENERATIONS=50
AI_MONTHLY_COST_CAP_USD=200.00
AI_BUDGET_ALERT_PCT=0.8

# Provider credentials belong only in the deployed .env.pilot/secrets store.
# Add the credential variable required by the selected gateway provider here
# when provisioning the VPS; do not place a real key in this template.

# Photo intake (photograph written work -> checkable lines). With no Mathpix
# credentials the scan endpoint stays disabled; OCR output is only ever a
# learner-confirmed suggestion, never graded directly.
PHOTO_OCR_PROVIDER=auto
MATHPIX_APP_ID=CHANGE_ME
MATHPIX_APP_KEY=CHANGE_ME

# Parent PIN rate limiting and short-lived adult unlocks
REDIS_URL=redis://redis:6379/0

# Staff (admin) two-factor: Fernet key that encrypts TOTP secrets at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- Pilot family approval -------------------------------------------------
# New self-registered families wait for admin approval while this is true.
REQUIRE_FAMILY_APPROVAL=true
# Base URL used in email links (no trailing slash).
PUBLIC_BASE_URL=https://mihur.example.com

# --- Outbound email (Gmail for the pilot) ----------------------------------
# console = log a redacted summary and send nothing (safe default).
# smtp    = deliver. For Gmail: turn on 2-Step Verification, create an
#           App Password (Google Account > Security > App passwords), and
#           paste the 16-character code below. Never use your real password.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=your.address@gmail.com
# Where "new family awaiting approval" notifications are sent.
ADMIN_NOTIFICATION_EMAIL=your.address@gmail.com

# --- Cloudflare edge security (see docs/operations/CLOUDFLARE_SETUP.md) -----
# Only set CLOUDFLARE_TRUSTED=true once the origin is locked down so ONLY
# Cloudflare can reach it — otherwise the CF-* headers are spoofable.
CLOUDFLARE_TRUSTED=true
# Block requests whose country is missing, unknown ("XX"/"T1"), or outside
# ALLOWED_COUNTRIES. Fails closed.
GEO_ENFORCEMENT_ENABLED=true
ALLOWED_COUNTRIES=US,CA

# Sign-in / registration throttles (Redis). Keep enabled.
AUTH_THROTTLES_ENABLED=true
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_PER_IP=5
REGISTER_RATE_WINDOW_SECONDS=3600
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Cloudflare Turnstile bot check on sign-in/registration.
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
